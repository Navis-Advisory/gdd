# User engagement state never belongs in the tool repo — except the worked
# example (the point of examples/) and bench runs, whose committed engagement
# is the sealed answer PROTOCOL.md grades against. Neither reaches the public
# surface: package.json `files` is an allowlist that omits bench/, and
# sync-public.sh excludes it and then asserts it absent.
.diligence/
!examples/**/.diligence/
!bench/deals/**/.diligence/

node_modules/
*.log

# background subagent worktrees
.claude/worktrees/

# Generated by session-start.sh (bin/install.js --claude --local) on every
# web/mobile session — projected copies of the plugin content at the repo
# root, not source.
.claude/commands/
.claude/agents/
.claude/gdd-core/
bench/tools/__pycache__/
